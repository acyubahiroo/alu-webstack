#!/usr/bin/env bash
# Displays information about the subdomains of a domain using dig and awk

display_info() {
    local domain="$1"
    local sub="$2"
    dig +noall +answer "$sub.$domain" | head -n 1 | awk -v s="$sub" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ "$#" -eq 1 ]
then
    for sub in www lb-01 web-01 web-02
    do
        display_info "$1" "$sub"
    done
elif [ "$#" -ge 2 ]
then
    display_info "$1" "$2"
else
    echo "Usage: 0-world_wide_web domain [subdomain]"
fi
